# PostgreSQL through PgBouncer for application traffic
DEPLOYMENT_ENV=production
DATABASE_URL=postgres://nisaab_runtime:replace-with-strong-password@pgbouncer:6432/app
# Runtime direct PostgreSQL connection for backup/restore data operations; migrations use separate operator credentials
DIRECT_URL=postgres://nisaab_runtime:replace-with-strong-password@postgres:5432/app
REDIS_URL=redis://:replace-with-valkey-hex-password@valkey:6379
DB_POOL_MAX=15
# Reuse SQL plans (never results). Enable only for direct PostgreSQL or PgBouncer
# >=1.21 with max_prepared_statements >0. Set 0 to restore unnamed queries.
DB_PREPARED_STATEMENTS=1

JWT_SECRET=replace-with-at-least-32-random-characters
# Optional dedicated printed-card key; set this before issuing production cards.
# Empty preserves existing legacy QR behavior. Changing JWT_SECRET then does not
# invalidate new cards signed with a configured dedicated key.
STUDENT_QR_SIGNING_SECRET=
STUDENT_QR_KEY_ID=v1
# JSON array of at most 3 {id,secret,expiresAt} entries for controlled rotation.
STUDENT_QR_PREVIOUS_KEYS=[]
# Optional transition for cards printed before dedicated keys. Keep the original
# JWT key here and set an explicit ISO expiry; never commit actual key values.
STUDENT_QR_LEGACY_SECRET=
STUDENT_QR_LEGACY_VALID_UNTIL=
# Required in production: use a dedicated 32+ character encryption secret.
# New production ciphertext never falls back to JWT_SECRET.
STREAMING_CREDENTIALS_SECRET=replace-with-another-32-character-random-secret
CRON_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_DOMAIN=nisaab360.app
APP_DOMAIN=nisaab360.app
PUBLIC_SITE_BASE_DOMAIN=nisaab360.app
API_ALLOWED_ORIGINS=https://nisaab360.app

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Optional server runtime override. Uploads also read the public name at runtime.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Institution-owned Google Drive backups (OAuth web application)
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_REDIRECT_URI=https://institution.nisaab360.app/api/institution/settings/google-drive/callback

POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=app

# Optional secondary encrypted upload performed by the application after Drive.
# Leave blank for Google Drive only. Plaintext B2 uploads are retired.
B2_REGION=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Dumps are temporary: removed on exit; crash leftovers reaped after 2 hours.
BACKUP_HEALTH_MAX_AGE_SECONDS=97200

# Central Database Backup — Google Drive (administrator-controlled, separate from institution backups)
# Step 1: Create a dedicated Google OAuth 2.0 web application in Google Cloud Console.
# Step 2: Add both redirect URIs to the OAuth app:
#   Localhost:   http://localhost:3000/api/sa/central-backup/google-drive/callback
#   Production:  https://sa.nisaab360.app/api/sa/central-backup/google-drive/callback
# Step 3: Fill in the client credentials below.
# Step 4: Open Super Admin -> Database Backup & Recovery, connect Drive,
#         verify the recovery email and enable nightly backups.
# The application creates its private backup folder and stores its refresh token
# encrypted. No token copying or fixed backup password is required.
GOOGLE_DRIVE_CENTRAL_CLIENT_ID=your-central-google-oauth-client-id
GOOGLE_DRIVE_CENTRAL_CLIENT_SECRET=your-central-google-oauth-client-secret
GOOGLE_DRIVE_CENTRAL_REDIRECT_URI=https://sa.nisaab360.app/api/sa/central-backup/google-drive/callback
# Legacy offline recovery only; unused when Drive is connected through the UI.
GOOGLE_DRIVE_CENTRAL_REFRESH_TOKEN=
CENTRAL_DATABASE_BACKUP_DRIVE_FOLDER_ID=
# No automatic backup on startup. One scheduled snapshot at 02:00 Asia/Karachi.
# Retention is the latest two verified packages whose password emails were accepted.
# Local recovery uses temporary RECOVERY_DATABASE_URL (new empty PostgreSQL 16)
# and RECOVERY_OUTPUT_DIRECTORY; never persist its temporary token/password here.

# Online payments: institution-owned credentials are encrypted in PostgreSQL.
# Provider endpoints have defaults; use these only for supported URL overrides.
PAYMENT_PUBLIC_ORIGIN=https://nisaab360.app
JAZZCASH_SANDBOX_CHECKOUT_URL=
JAZZCASH_CHECKOUT_URL=
# This implementation supports the Easypaisa REST v4 Mobile Account contract.
# RSA v5/QR products require their own approved adapter, not substituted URLs.
EASYPAISA_SANDBOX_INITIATE_URL=
EASYPAISA_SANDBOX_INQUIRY_URL=
EASYPAISA_INITIATE_URL=
EASYPAISA_INQUIRY_URL=

# Optional Expo enhanced push security bearer; configure matching access token in EAS.
EXPO_ACCESS_TOKEN=

# Security rollout: role must be provisioned before starting the new runtime.
DATABASE_RUNTIME_USER=nisaab_runtime
DATABASE_RUNTIME_PASSWORD=replace-with-random-64-hex-characters
VALKEY_PASSWORD=replace-with-separate-random-64-hex-characters
# Provider preset: unsigned=false; settings.max_file_size=5242880 (or lower).
CLOUDINARY_CONTENT_UPLOAD_PRESET=nisaab360-signed-content
STREAMING_CREDENTIALS_KEY_ID=primary
STREAMING_CREDENTIALS_PREVIOUS_KEYS=[]
# Old dedicated key (or old JWT secret) only while migrating v1 ciphertext.
STREAMING_CREDENTIALS_LEGACY_SECRET=
