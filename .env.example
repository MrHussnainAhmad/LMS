# PostgreSQL through PgBouncer for application traffic
DEPLOYMENT_ENV=production
DATABASE_URL=postgres://app:replace-with-strong-password@pgbouncer:6432/app
# Direct PostgreSQL connection used only by the migration job
DIRECT_URL=postgres://app:replace-with-strong-password@postgres:5432/app
REDIS_URL=redis://valkey:6379
DB_POOL_MAX=15

JWT_SECRET=replace-with-at-least-32-random-characters
# Recommended: use a different 32+ character secret for encrypting Bunny/Mux
# credentials. If omitted, the application safely falls back to JWT_SECRET.
STREAMING_CREDENTIALS_SECRET=replace-with-another-32-character-random-secret
CRON_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_DOMAIN=nisaab360.app
PUBLIC_SITE_BASE_DOMAIN=nisaab360.app
API_ALLOWED_ORIGINS=https://nisaab360.app

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Institution-owned Google Drive backups (OAuth web application)
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_REDIRECT_URI=https://institution.nisaab360.app/api/institution/settings/google-drive/callback

POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=app

B2_REGION=your-b2-region
B2_APPLICATION_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-private-backup-bucket
BACKUP_KEEP_DAYS=30
BACKUP_ON_STARTUP=true

# Central Database Backup — Google Drive (administrator-controlled, separate from institution backups)
# Step 1: Create a dedicated Google OAuth 2.0 web application in Google Cloud Console.
# Step 2: Add both redirect URIs to the OAuth app:
#   Localhost:   http://localhost:3000/api/sa/central-backup/google-drive/callback
#   Production:  https://your-production-domain.app/api/sa/central-backup/google-drive/callback
# Step 3: Fill in the client credentials below.
# Step 4: As super-admin, visit GET /api/sa/central-backup/google-drive/connect,
#         complete the OAuth consent flow in your browser, then copy the refresh
#         copy the one-time token shown by the callback into GOOGLE_DRIVE_CENTRAL_REFRESH_TOKEN.
# Step 5: Pre-create Nisaab360/Domain_backups and Nisaab360/Institution_backups
#         in the admin Google Drive and paste their folder IDs below.
GOOGLE_DRIVE_CENTRAL_CLIENT_ID=your-central-google-oauth-client-id
GOOGLE_DRIVE_CENTRAL_CLIENT_SECRET=your-central-google-oauth-client-secret
GOOGLE_DRIVE_CENTRAL_REDIRECT_URI=https://your-production-domain.app/api/sa/central-backup/google-drive/callback
# Obtained once via the admin OAuth flow (see step 4 above). Never log or expose this value.
GOOGLE_DRIVE_CENTRAL_REFRESH_TOKEN=your-central-google-drive-refresh-token
# ID of the pre-created Nisaab360/Domain_backups/ folder.
CENTRAL_DATABASE_BACKUP_DRIVE_FOLDER_ID=your-google-drive-folder-id
# ID of the pre-created Nisaab360/Institution_backups/ folder.
CENTRAL_INSTITUTION_BACKUPS_DRIVE_FOLDER_ID=your-google-drive-institution-backups-folder-id
# Used only by the optional smoke-test script; production encryption password is set
# by a SUPER_ADMIN at /sa/backups and is stored encrypted in PostgreSQL.
CENTRAL_DATABASE_BACKUP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Retention: number of daily and monthly backup files to keep in Google Drive.
CENTRAL_DATABASE_BACKUP_KEEP_DAILY=30
CENTRAL_DATABASE_BACKUP_KEEP_MONTHLY=12
