{
    admin :2019
}

:3000, http://localhost:3000, http://127.0.0.1:3000, nisaab360.app, www.nisaab360.app, blog.nisaab360.app, student.nisaab360.app, staff.nisaab360.app, institution.nisaab360.app, employee.nisaab360.app, sa.nisaab360.app, superadmin.nisaab360.app {
    # Use HTTP-01 for public certificates. TLS-ALPN-01 is being answered by
    # another endpoint before it reaches this Caddy instance.
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    reverse_proxy {
        to app:3000 app2:3000
        lb_policy least_conn

        health_uri /api/health
        health_interval 10s
        health_timeout 3s
        health_fails 2
        health_passes 1

        fail_duration 30s
        max_fails 1
        unhealthy_status 5xx
    }
}

# Redirect local HTTP to Caddy's locally-issued HTTPS certificate. This lets
# browsers with HTTPS-first mode enabled use localhost without protocol errors.
http://localhost, http://*.localhost {
    redir https://{host}{uri} permanent
}

# `*.localhost` supports the same portal subdomains locally (student.localhost,
# staff.localhost, etc.) without requesting a public certificate.
https://localhost, https://*.localhost {
    tls internal

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    reverse_proxy {
        to app:3000 app2:3000
        lb_policy least_conn
        health_uri /api/health
        health_interval 10s
        health_timeout 3s
        health_fails 2
        health_passes 1
        fail_duration 30s
        max_fails 1
        unhealthy_status 5xx
    }
}
