    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.2",
    "@types/archiver": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@uiw/react-md-editor": "^4.1.1",
    "@zip.js/zip.js": "2.23.0",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "archiver-zip-encrypted": "^2.0.0",
    "autoprefixer": "^10.5.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "framer-motion": "^12.42.2",
    "hls.js": "^1.7.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.16",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "pg-query-stream": "^4.17.0",
    "postcss": "^8.5.26",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/pg-query-stream": "^1.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
