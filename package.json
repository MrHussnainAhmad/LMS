{
  "name": "lms-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start-local.mjs",
    "start:server-only": "node scripts/prepare-standalone.mjs && node --env-file=.env scripts/standalone-server.cjs",
    "lint": "eslint",
    "lint:tenant": "node scripts/audit-tenant-scope.mjs",
    "verify:admissions": "tsx scripts/verify-admissions.ts",
    "verify:admission-campuses": "node --import tsx scripts/verify-admission-campus.tsx",
    "verify:campuses": "node --import tsx scripts/verify-campus-workspaces.ts",
    "verify:restores": "node --import tsx --test scripts/verify-institution-restores.ts",
    "db:migrate:production": "node --env-file=.env scripts/migrate-production.mjs --apply",
    "verify:cache-policy": "node --import tsx scripts/verify-cache-policy.ts",
    "verify:roles": "node --import tsx scripts/verify-role-boundaries.ts",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:billing": "node --import tsx scripts/verify-fee-billing.ts",
    "release:preflight": "node --env-file=.env --env-file=deployment/release.env scripts/release-preflight.mjs",
    "verify:billing-ui": "node scripts/verify-billing-ui.cjs",
    "verify:forms": "node --import tsx scripts/verify-form-validation.ts",
    "verify:forms-ui": "node scripts/verify-form-validation-ui.cjs",
    "verify:request-costs": "node scripts/verify-request-costs.cjs",
    "verify:request-costs-ui": "node scripts/verify-request-costs-ui.cjs",
    "verify:website-builder": "node --import tsx scripts/verify-public-site-builder.ts",
    "verify:website-builder-ui": "node scripts/verify-public-site-builder-ui.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
