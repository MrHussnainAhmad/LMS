{
  "name": "lms-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start-local.mjs",
    "start:server-only": "node scripts/prepare-standalone.mjs && node --env-file=.env .next/standalone/server.js",
    "lint": "eslint",
    "lint:tenant": "node scripts/audit-tenant-scope.mjs",
    "verify:admissions": "tsx scripts/verify-admissions.ts",
    "seed:admissions": "tsx scripts/seed-admission-applications.ts",
    "verify:backups": "node --env-file=.env --import tsx scripts/verify-institution-backups.ts",
    "verify:refresh-tokens": "node --env-file=.env --import tsx scripts/verify-refresh-token-rotation.ts",
    "verify:parent-assessments": "node --env-file=.env scripts/verify-parent-assessment-workflows.mjs",
    "verify:security": "npm run lint:tenant && node --env-file=.env --import tsx scripts/verify-security-guards.ts",
    "migrate:backup-layout": "node --env-file=.env --import tsx scripts/migrate-backup-layout.ts --apply",
    "db:migrate:production": "node --env-file=.env scripts/migrate-production.mjs --apply"
  },
  "dependencies": {
