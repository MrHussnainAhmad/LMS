    "@types/pg": "^8.20.0",
    "@types/pg-query-stream": "^1.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "gh-pages": "^6.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
