    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "hls.js": "^1.7.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "next": "16.3.2",
    "next-remove-imports": "^1.0.13",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "pg-query-stream": "^4.17.0",
    "postcss": "^8.5.26",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.3"
